#!/usr/bin/env bash
# pre-push: reject force pushes, then run the exact CI locally.
#
# Force guard first (cheap, rejects before a long CI run). A push is a
# force when the remote ref is not an ancestor of the local oid (a
# non-fast-forward rewrite): it drops the current branch tip for every
# other agent pulling that branch, and the old commits are only
# recoverable from a reflog nobody is guaranteed to have. That must be
# an explicit human decision, not a default: when a rewrite is genuinely
# needed (messy history), get the human's go-ahead, then re-run with
#   EPIC_FORCE_PUSH_APPROVED=1 git push --force-with-lease
# New branches and branch deletions are not rewrites and always pass.
#
# Then the CI reproduction: `make ci-local` is the 1-to-1 reproduction
# for `epic-cc-ci:latest bash scripts/ci-test.sh` that CI runs (see
# #99). `cargo test -- --skip gpasm` is NOT the same, it skips
# `pic14e_firewall` and other Docker-only checks.

set -u

# ---- force-push guard ----

approved="${EPIC_FORCE_PUSH_APPROVED:-0}"
force_refs=""

while read -r local_ref local_oid remote_ref remote_oid; do
    [ -z "$local_ref" ] && continue
    [ "$remote_oid" = "0000000000000000000000000000000000000000" ] && continue
    [ "$local_oid" = "0000000000000000000000000000000000000000" ] && continue
    if ! git merge-base --is-ancestor "$remote_oid" "$local_oid" 2>/dev/null; then
        force_refs="$force_refs $local_ref"
    fi
done

if [ -n "$force_refs" ]; then
    if [ "$approved" = "1" ]; then
        echo "pre-push: force push approved for:$force_refs (EPIC_FORCE_PUSH_APPROVED=1)"
    else
        echo "pre-push: refusing force push of:$force_refs" >&2
        echo "  A force push rewrites shared branch history and drops the current" >&2
        echo "  branch commits for every other agent working this repo." >&2
        echo "  If the rewrite is genuinely needed, get the human's explicit" >&2
        echo "  go-ahead, then re-run with:" >&2
        echo "    EPIC_FORCE_PUSH_APPROVED=1 git push --force-with-lease" >&2
        exit 1
    fi
fi

# ---- suite stamp (epic-cc#1296) ----
# `epic-tasks push` retries a dropped connection once; the retry must not
# pay for `make ci-local` twice. Stamp the tree the suite already passed,
# keyed on the tree hash plus this hook's own content hash, so any tree or
# hook change runs the suite again. The prose gate below still runs on
# every push: it is cheap, and skipping it would weaken the gate.
stamp_file="$(git rev-parse --absolute-git-dir 2>/dev/null)/epic-pre-push-stamp"
tree="$(git rev-parse 'HEAD^{tree}' 2>/dev/null)"
hook_sum="$(git hash-object "${0}" 2>/dev/null)"
if [ -n "$tree" ] && [ -n "$hook_sum" ] && [ -f "$stamp_file" ] \
    && grep -qx "$tree $hook_sum" "$stamp_file" 2>/dev/null; then
    echo "pre-push: suite already passed for this tree, skipping"
else
    # The suite is a gate, not a report: a red `make ci-local` refuses the
    # push (epic-cc#1238). No bypass exists for parked branches with known
    # red tests: AGENTS.md forbids skipping this hook, so a red suite means
    # fixing the tests first, not pushing around them.
    echo "pre-push: make ci-local (docker epic-cc-ci bash scripts/ci-test.sh) — see #99"
    if ! make ci-local; then
        echo "pre-push: local CI failed; refusing the push" >&2
        exit 1
    fi
    # The suite passed on this tree under this hook: stamp it so a retry of
    # the same push skips the re-run above.
    if [ -n "$tree" ] && [ -n "$hook_sum" ] && [ -n "$stamp_file" ]; then
        printf '%s %s\n' "$tree" "$hook_sum" > "$stamp_file" 2>/dev/null || true
    fi
fi

# ---- prose lint gate (fires even when the ritual was never run) ----

if ! bash scripts/prose-diff.sh --verify; then
    echo "pre-push: comment blocks violating the prose rules (see above)" >&2
    echo "  Fix the flagged blocks, or reword them so they hold up." >&2
    exit 1
fi
