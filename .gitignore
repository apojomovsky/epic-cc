# Rust
/target/
**/*.rs.bk

# Vendored material: proprietary installers, copyrighted docs and books.
# Only the README describing the layout is tracked.
/vendor/*
!/vendor/README.md

# Reference PDFs must never be committed — copyrighted, see docs/06-environment.md
*.pdf

# Build / test artifacts
__pycache__/
*.hex
*.lst
*.cod
*.map
*.o
*.ll
/scratch/

# Root scratch asm dumps (crates/asm/tests/fixtures/*.asm are tracked fixtures)
/_*.asm
# Claude Code placeholder, conventions live in AGENTS.md
/CLAUDE.md

# Throwaway feasibility spike (docs/10-spike-findings.md). Not part of the product.
/spike/

# Agent worktrees
/.worktrees/
# DFP / ATDF packs: authoritative device data, free download, never committed.
# Only the derived TOML in crates/device/devices/*.toml is tracked.
*.atdf
*.ATDF
*.atpack
*.PIC
*.pic
dfp/
atdf/
# Exception: hand-authored fixtures describing no real silicon, not vendor files.
!scripts/fixtures/synthetic.atdf
!scripts/fixtures/synthetic_pic18.atdf
