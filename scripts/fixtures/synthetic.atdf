<edc:PIC xmlns:edc="http://crownking/edc" edc:name="PIC14SYN01">
  <edc:MemTraits edc:hwstackdepth="0x8"/>
  <edc:ConfigFuseSector edc:beginaddr="0x2007" edc:endaddr="0x2007"/>
</edc:PIC>
