#!/usr/bin/env bash
# pre-commit: workspace hygiene before every commit.
#   - rustfmt --check on the staged Rust files, via the dev container
#     (the only rustfmt that exists; nothing rust-related is installed
#     on the host)
#   - cargo build --workspace --all-targets must be warning-free (hard
#     gate: rustc's own lints, unlike clippy's, are high-signal and
#     rarely worth silencing; a dead_code warning caught a real orphaned
#     function during the sweep that first cleared this backlog, see
#     PR #57)
#   - trailing whitespace on staged files
#
# Install with: make setup-hooks

set -uo pipefail

CACHE_DIR="${HOME}/.cache/epic-cc"
CARGO_HOME_CACHE="$CACHE_DIR/cargo-home"
# Same per-worktree target dir the Makefile builds into (#889): same
# command, flags and profile, so the gate reuses the warm cache instead
# of doubling it, and cargo replays cached warnings on a fresh build, so
# the grep still fires. Serialized with the Makefile's lock, since a
# commit during `make test` now contends for one cache dir.
TARGET_CACHE="$CACHE_DIR/target$(printf '%s' "$PWD" | tr '/' '-')"
TOPLEVEL="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
DEV_IMAGE="$(bash "$TOPLEVEL/scripts/dev-image-tag.sh" 2>/dev/null || true)"

# Only check files that are actually staged; respect the dev container's
# existence (skip format checks if the image isn't built yet, e.g. first
# commit in a fresh clone).
staged_rs=$(git diff --cached --name-only --diff-filter=ACM -- '*.rs')

if [ -n "$staged_rs" ]; then
  if [ -n "$DEV_IMAGE" ] && docker image inspect "$DEV_IMAGE" >/dev/null 2>&1; then
    if ! echo "$staged_rs" | docker run --rm -i \
      --user "$(id -u):$(id -g)" \
      -v /etc/passwd:/etc/passwd:ro -v /etc/group:/etc/group:ro \
      -v "$PWD":/workspace -w /workspace "$DEV_IMAGE" \
      bash -c 'xargs rustfmt --check --edition 2021' >/dev/null 2>&1; then
      echo "pre-commit: staged Rust files are not rustfmt-clean; run: make fmt"
      exit 1
    fi

    mkdir -p "$CARGO_HOME_CACHE" "$TARGET_CACHE"
    build_out=$(bash "$TOPLEVEL/scripts/with-target-lock.sh" "$TARGET_CACHE/.build.lock" docker run --rm \
      --user "$(id -u):$(id -g)" \
      -v /etc/passwd:/etc/passwd:ro -v /etc/group:/etc/group:ro \
      -v "$CARGO_HOME_CACHE":/opt/cargo-home -e CARGO_HOME=/opt/cargo-home \
      -v "$TARGET_CACHE":/tmp/cargo-target -e CARGO_TARGET_DIR=/tmp/cargo-target \
      -v "$PWD":/workspace -w /workspace "$DEV_IMAGE" \
      bash -c 'cargo build --workspace --all-targets 2>&1')
    warnings=$(printf '%s\n' "$build_out" | grep '^warning:' || true)
    if [ -n "$warnings" ]; then
      echo "pre-commit: compiler warnings present (cargo build --workspace --all-targets):"
      printf '%s\n' "$build_out" | sed 's/^/pre-commit:   /'
      echo "pre-commit: fix them before committing (see AGENTS.md)"
      exit 1
    fi
  else
    echo "pre-commit: $DEV_IMAGE not built, skipping rustfmt/warnings checks (make image)"
  fi
fi

# Staged Python files get the same treatment via ruff (pinned in the
# Dockerfile, same image): `ruff check` plus `ruff format --check` over
# exactly the staged files, so a commit can never land python the takeoff
# ritual would reject.
staged_py=$(git diff --cached --name-only --diff-filter=ACM -- '*.py')

if [ -n "$staged_py" ]; then
  if [ -n "$DEV_IMAGE" ] && docker image inspect "$DEV_IMAGE" >/dev/null 2>&1; then
    if ! echo "$staged_py" | docker run --rm -i \
      --user "$(id -u):$(id -g)" \
      -v /etc/passwd:/etc/passwd:ro -v /etc/group:/etc/group:ro \
      -v "$PWD":/workspace -w /workspace "$DEV_IMAGE" \
      bash -c 'xargs bash scripts/lint-python.sh' >/dev/null 2>&1; then
      echo "pre-commit: staged Python files fail ruff; run: bash scripts/lint-python.sh --fix"
      exit 1
    fi
  else
    echo "pre-commit: $DEV_IMAGE not built, skipping python lint (make image)"
  fi
fi

# Trailing whitespace on staged files (any kind). `git diff --check` exits
# nonzero on violations; keep its exit status (a pipe would mask it).
if ! git diff --cached --check; then
  echo "pre-commit: trailing whitespace or conflict markers; fix and re-stage"
  exit 1
fi

# Missing final newline on staged text files. `git diff --check` does not
# flag a file whose last byte is not a newline, but a missing EOF newline is
# a real hygiene defect (POSIX text files end in a newline; a diff hunk that
# appends to such a file shows a spurious `\ No newline at end of file`).
# Skip binary files (a NUL byte in the first 8 KiB marks them as such).
staged_all=$(git diff --cached --name-only --diff-filter=ACM)
if [ -n "$staged_all" ]; then
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    before=$(head -c 8192 "$f" 2>/dev/null | wc -c)
    after=$(head -c 8192 "$f" 2>/dev/null | tr -d '\000' | wc -c)
    if [ "$after" -lt "$before" ]; then
      continue # binary (a NUL byte was stripped)
    fi
    if [ -s "$f" ] && [ "$(tail -c 1 "$f" | od -An -c | tr -d ' ')" != "\\n" ]; then
      echo "pre-commit: $f is missing a final newline; add one and re-stage"
      exit 1
    fi
  done <<< "$staged_all"
fi

exit 0
